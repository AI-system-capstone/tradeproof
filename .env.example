# 복사해서 .env 로 사용: cp .env.example .env
# 개발용 값입니다. 실제 비밀번호를 커밋하지 마세요.

# Postgres
POSTGRES_USER=tradeproof
POSTGRES_PASSWORD=tradeproof-dev
POSTGRES_DB=tradeproof
DATABASE_URL=postgresql://tradeproof:tradeproof-dev@postgres:5432/tradeproof

# 오브젝트 스토리지 (SeaweedFS 를 minio:9000 으로 제공, 11/9 결정)
BLOB_ENDPOINT=minio:9000
BLOB_ACCESS_KEY=tradeproof
BLOB_SECRET_KEY=tradeproof-dev-secret
BLOB_SECURE=false

# 모듈 주소 (compose·k3s 공통 서비스 이름)
SCREENING_URL=http://a-screening:8000
REGISTRY_URL=http://b-registry:8100
REPLAY_URL=http://c-replay:8200
PLATFORM_URL=http://d-platform:8300

# 심사 서비스가 사용할 번들 (D가 배포 시 주입)
BUNDLE_ID=B-1
LOG_LEVEL=INFO
