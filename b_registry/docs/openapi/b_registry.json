          "canary"
        ],
        "title": "ActiveBundles"
      },
      "Body_upload_imports_post": {
        "properties": {
          "package": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Package"
          }
        },
        "type": "object",
        "required": [
          "package"
        ],
        "title": "Body_upload_imports_post"
      },
      "BundleRegistered": {
        "properties": {
          "bundle_id": {
            "type": "string",
            "title": "Bundle Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bundle_id"
        ],
        "title": "BundleRegistered"
      },
      "BundleResult": {
        "properties": {
          "bundle_id": {
            "type": "string",
            "title": "Bundle Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "validated",
              "validation_failed",
              "approved",
              "rejected",
              "canary",
              "cancelled",
              "active",
              "superseded"
            ],
            "title": "Status"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "list_id": {
            "type": "string",
            "title": "List Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "model": {
            "$ref": "#/components/schemas/AIModelResult"
          },
          "list": {
            "$ref": "#/components/schemas/SanctionsListResult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bundle_id",
          "status",
          "model_id",
          "list_id",
          "created_at",
          "model",
          "list"
        ],
        "title": "BundleResult"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "target_id"
        ],
        "title": "ErrorResponse"
      },
      "ImportAccepted": {
        "properties": {
          "import_id": {
            "type": "string",
            "title": "Import Id"
          },
          "bundle_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bundle Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "import_id",
          "bundle_id"
        ],
        "title": "ImportAccepted",
        "description": "Package validation and registration have completed synchronously."
      },
      "SanctionsListResult": {
        "properties": {
          "list_id": {
            "type": "string",
            "title": "List Id"
          },
          "uri": {
            "type": "string",
            "title": "Uri"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "list_id",
          "uri"
        ],
        "title": "SanctionsListResult"
      },
      "Transition": {
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "candidate",
              "validated",
              "validation_failed",
              "approved",
              "rejected",
              "canary",
              "cancelled",
              "active",
              "superseded"
            ],
            "title": "To"
          },
          "actor": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "to",
          "actor",
          "reason"
        ],
        "title": "Transition"
      },
