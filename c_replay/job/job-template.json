{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "registry-replay-template",
    "labels": { "app": "c-validation" }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 3600,
    "template": {
      "metadata": { "labels": { "app": "c-validation" } },
      "spec": {
        "restartPolicy": "Never",
        "terminationGracePeriodSeconds": 30,
        "containers": [
          {
            "name": "c-validation",
            "image": "tradeproof/c-replay-job:dev",
            "imagePullPolicy": "IfNotPresent",
            "command": ["python", "-m", "c_replay.job"],
            "envFrom": [{ "secretRef": { "name": "tradeproof-env" } }],
            "env": [{ "name": "B_URL", "value": "http://b-registry:8100" }]
          }
        ]
      }
    }
  }
}
