{
  "title": "TradeProof 운영",
  "uid": "tradeproof",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "운영 번들 / canary 비율(%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_platform_canary_weight",
          "legendFormat": "canary %",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "진행 중 없음",
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "운영 번들",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_platform_stable_bundle_info",
          "legendFormat": "{{bundle_id}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "롤백 수 (사유별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_platform_rollbacks",
          "legendFormat": "{{reason}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "판정 건수 (번들·분류별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_screening_results_total",
          "legendFormat": "{{bundle_id}} {{classification}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "심사 대기열 (상태별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_screening_jobs",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "처리 시간 평균 (번들별, 최근 100건)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_screening_processing_seconds_avg",
          "legendFormat": "{{bundle_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "OCR 신뢰도 평균 (번들별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_ocr_confidence_avg",
          "legendFormat": "{{bundle_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "canary 감시: 처리 시간 비율 (후보÷운영, 기준 2.0)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (bundle_id)(tradeproof_screening_processing_seconds_avg) / scalar(max(tradeproof_screening_processing_seconds_avg * on(bundle_id) group_left tradeproof_platform_stable_bundle_info))",
          "legendFormat": "{{bundle_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "담당자 검토로 간 비율 (번들별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bundle_id)(tradeproof_screening_results_total{classification=\"MANUAL_REVIEW\"}) / sum by (bundle_id)(tradeproof_screening_results_total)",
          "legendFormat": "{{bundle_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "배포 수 (상태별) · 담당자 판단",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_platform_deployments",
          "legendFormat": "배포 {{status}}"
        },
        {
          "refId": "B",
          "expr": "tradeproof_review_decisions",
          "legendFormat": "판단 {{decision}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "AI 판정 채점 (번들별 맞음·틀림, 검토 목록)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tradeproof_review_feedback",
          "legendFormat": "{{bundle_id}} {{verdict}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "canary 감시: 틀림 비율 (번들별, 기준 0.5)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bundle_id)(tradeproof_review_feedback{verdict=\"incorrect\"}) / sum by (bundle_id)(tradeproof_review_feedback)",
          "legendFormat": "{{bundle_id}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
